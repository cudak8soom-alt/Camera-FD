# ============================================================
# POINT A — one settings file (edit this, save as .env)
# ============================================================

# --- 1) Camera (same network as this PC) ---
DAHUA_HOST=192.168.103.108
DAHUA_USER=admin
DAHUA_PASSWORD=your_camera_password

FTP_USER=dahua
FTP_PASSWORD=choose_an_ftp_password
FTP_PORT=21
FTP_DIR=output/faces_camera

CAMERA_ROTATE=1
CAMERA_KEEPALIVE_MINUTES=15

# --- 2) Send pictures to Point B (values from your provider) ---
SITE_ID=office1
POINT_B_URL=http://100.x.x.x:8787
SYNC_TOKEN=paste_token_here
