# Camera web login — required so serve.py can lock Face Detection + FTP settings.
DAHUA_HOST=192.168.103.108
DAHUA_USER=admin
DAHUA_PASSWORD=your_camera_password

# FTP inbox — must match camera Network → FTP / NAS settings (serve.py also writes these).
FTP_USER=dahua
FTP_PASSWORD=choose_an_ftp_password
FTP_PORT=21
FTP_DIR=output/faces_camera

# Image rotation the face AI needs on this camera (do not change in the camera UI).
CAMERA_ROTATE=1

# Re-apply camera settings every N minutes while serve.py runs (0 = only on start).
CAMERA_KEEPALIVE_MINUTES=5
